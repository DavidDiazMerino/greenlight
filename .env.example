# Optional live integration configuration. Never commit populated values.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Standard OTEL key=value format. Percent-encode spaces (for example Basic%20...).
OTEL_EXPORTER_OTLP_HEADERS=
GREENLIGHT_GRAFANA_INGEST_WAIT_MS=10000
